<odoo>
    <record id="res_config_settings_view_hide_pickings" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='quick_edit_mode']" position="after">
                <block
                    title="Account Invoice Report Grouped By Pickings"
                    name="group_account_invoice_report_grouped_by_picking_hide_pickings"
                >
                    <setting
                        id="hide_return_pickings_default"
                        string="Default Hide Return Pickings"
                        help="Hide return pickings by default from the invoice report in the return wizard."
                    >
                        <field name="hide_return_pickings_default" />
                    </setting>

                    <setting
                        id="hide_pickings_update_qty"
                        string="Update Qty Hiding Pickings"
                        help="Do not edit the final quantity when hiding pickings from the invoice report."
                    >
                        <field name="hide_pickings_update_qty" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
